// Prisma schema for Echo — see /Users/gk/.claude/plans/rosy-mixing-rose.md for the full design doc

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CheckIn {
  id            String   @id @default(cuid())
  placeName     String
  lat           Float
  lng           Float
  emoji         String
  timestamp     DateTime
  amountSpent   Float?
  spendCategory String?
  isWorkout     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([timestamp])
}

model Settings {
  id          Int     @id @default(1)
  trackerName String  @default("")
  shareToken  String? @unique
}

// One row per calendar day of daily (non-check-in) tracking — deliberately consolidated
// into a single table, rather than one table per habit, so a future "wrapped"-style
// yearly summary can scan one table instead of joining several.
model DailyLog {
  date             DateTime @id
  dinnerType       String? // "made" | "purchased"
  didNotLeaveHouse Boolean  @default(false)
  mood             Int? // 1-5
}
